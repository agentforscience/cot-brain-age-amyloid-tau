\citation{kearney2026tapgpt}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces  A confound we checked rather than assumed. AUC is computed from the model's \emph  {stated} confidence, so confidence granularity can drive it. On \textsc  {Progression}\xspace  the \textsc  {Direct}\xspace  condition emits only two distinct confidence values, which mechanically depresses its AUC; on the threshold-free metric \textsc  {Direct}\xspace  is in fact better than \textsc  {CoT}\xspace  (0.702 vs.\ 0.666). What \textsc  {CoT}\xspace  does genuinely deliver on \textsc  {Progression}\xspace  is far better calibration (ECE 0.083 vs.\ 0.314)---a real benefit, but a different one from the hypothesised gain in discrimination. \relax }}{8}{table.caption.6}\protected@file@percent }
\newlabel{tab:calibration}{{4}{8}{A confound we checked rather than assumed. AUC is computed from the model's \emph {stated} confidence, so confidence granularity can drive it. On \taskthree the \direct condition emits only two distinct confidence values, which mechanically depresses its AUC; on the threshold-free metric \direct is in fact better than \cotarm (0.702 vs.\ 0.666). What \cotarm does genuinely deliver on \taskthree is far better calibration (ECE 0.083 vs.\ 0.314)---a real benefit, but a different one from the hypothesised gain in discrimination. \relax }{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  Confidence resolution and calibration. \textsc  {CoT}\xspace  spreads its confidence over ten distinct values on both classification tasks, whereas \textsc  {Direct}\xspace  collapses to two on \textsc  {Progression}\xspace  . The reliability curves show \textsc  {CoT}\xspace  is the only well-calibrated condition on \textsc  {Progression}\xspace  (ECE 0.083), and that all three conditions are similarly overconfident on \textsc  {Tau-Stage}\xspace  . \relax }}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:calibration}{{2}{8}{Confidence resolution and calibration. \cotarm spreads its confidence over ten distinct values on both classification tasks, whereas \direct collapses to two on \taskthree . The reliability curves show \cotarm is the only well-calibrated condition on \taskthree (ECE 0.083), and that all three conditions are similarly overconfident on \taskone . \relax }{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Robustness: supported in slope, vacuous in level}{8}{subsection.4.4}\protected@file@percent }
\newlabel{sec:results:robust}{{4.4}{8}{Robustness: supported in slope, vacuous in level}{subsection.4.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  Early answering. Each curve shows how often the answer produced from a truncated chain matches the full-chain answer, as a function of how much of the chain the model is shown. A faithful chain should start low and climb; the two classification tasks start at 0.76--0.83, meaning the answer is essentially fixed before any reasoning is revealed. The continuous target (\textsc  {Brain-Age}\xspace  , using the normalised answer shift of equation\nobreakspace  {}\ref  {eq:shift}) is the only task with a substantial area over the curve. \relax }}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:early}{{3}{9}{Early answering. Each curve shows how often the answer produced from a truncated chain matches the full-chain answer, as a function of how much of the chain the model is shown. A faithful chain should start low and climb; the two classification tasks start at 0.76--0.83, meaning the answer is essentially fixed before any reasoning is revealed. The continuous target (\tasktwo , using the normalised answer shift of \eqref {eq:shift}) is the only task with a substantial area over the curve. \relax }{figure.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces  Causal faithfulness of the \textsc  {Qwen2.5-7B}\xspace  chains. On the two classification tasks the chains are essentially post-hoc narration: showing the model none of its own reasoning reproduces the full-chain answer 75--83\% of the time, and a 10$\times $ corruption of a biomarker value inside the chain changes the answer 2--4\% of the time. On the continuous target the picture inverts---\textsc  {AOC}\xspace  is 5.7$\times $ higher and mistake injection moves the prediction by 0.33\,SD. Uniformly low paraphrase sensitivity shows the chains are not using encoded reasoning; the information is where it appears to be, there is simply very little of it. \relax }}{9}{table.caption.9}\protected@file@percent }
\newlabel{tab:faithfulness}{{5}{9}{Causal faithfulness of the \qwenseven chains. On the two classification tasks the chains are essentially post-hoc narration: showing the model none of its own reasoning reproduces the full-chain answer 75--83\% of the time, and a 10$\times $ corruption of a biomarker value inside the chain changes the answer 2--4\% of the time. On the continuous target the picture inverts---\aoc is 5.7$\times $ higher and mistake injection moves the prediction by 0.33\,SD. Uniformly low paraphrase sensitivity shows the chains are not using encoded reasoning; the information is where it appears to be, there is simply very little of it. \relax }{table.caption.9}{}}
