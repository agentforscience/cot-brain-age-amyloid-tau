\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces  Out-of-fold accuracy under grouped 5-fold cross-validation, with donor/subject-clustered bootstrap CIs ($B=2000$). Best per column in {\bf  bold}. \textsc  {CoT}\xspace  never reaches the best tabular baseline on any task, and on \textsc  {Brain-Age}\xspace  \emph  {every} LLM condition is worse than the trivial predictor that outputs the cohort mean age (italicised). \relax }}{7}{table.caption.4}\protected@file@percent }
\newlabel{tab:accuracy}{{2}{7}{Out-of-fold accuracy under grouped 5-fold cross-validation, with donor/subject-clustered bootstrap CIs ($B=2000$). Best per column in {\bf bold}. \cotarm never reaches the best tabular baseline on any task, and on \tasktwo \emph {every} LLM condition is worse than the trivial predictor that outputs the cohort mean age (italicised). \relax }{table.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces  Paired condition contrasts on identical rows, clustered paired bootstrap with Benjamini--Hochberg FDR within family. On \textsc  {Tau-Stage}\xspace  , \textsc  {CoT}\xspace  is significantly worse than semantically empty filler tokens of the same length. On \textsc  {Progression}\xspace  the sign reverses, but table\nobreakspace  {}\ref  {tab:calibration} shows that advantage is largely a confidence-verbalisation effect. On \textsc  {Brain-Age}\xspace  no contrast is significant. Negative $\Delta $MAE favours \textsc  {CoT}\xspace  . \relax }}{7}{table.caption.5}\protected@file@percent }
\newlabel{tab:contrasts}{{3}{7}{Paired condition contrasts on identical rows, clustered paired bootstrap with Benjamini--Hochberg FDR within family. On \taskone , \cotarm is significantly worse than semantically empty filler tokens of the same length. On \taskthree the sign reverses, but \tabref {tab:calibration} shows that advantage is largely a confidence-verbalisation effect. On \tasktwo no contrast is significant. Negative $\Delta $MAE favours \cotarm . \relax }{table.caption.5}{}}
