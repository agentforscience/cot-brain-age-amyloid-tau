\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces  Accuracy and faithfulness reported jointly, as \citet  {bentham2024disguised} require. The 1.5B model cannot do the task without reasoning (\textsc  {Direct}\xspace  AUC 0.504 $\approx $ chance), CoT lifts it to 0.586, and its chains are 3.7$\times $ more causally load-bearing and 6$\times $ more sensitive to injected mistakes. The 7B model already knows the answer, its chains are decorative, and verbalising them costs accuracy. The 1.5B forced-answer rate is a caveat on the magnitude, not the direction (section\nobreakspace  {}\ref  {sec:discussion}). \relax }}{13}{table.caption.17}\protected@file@percent }
\newlabel{tab:modelsize}{{10}{13}{Accuracy and faithfulness reported jointly, as \citet {bentham2024disguised} require. The 1.5B model cannot do the task without reasoning (\direct AUC 0.504 $\approx $ chance), CoT lifts it to 0.586, and its chains are 3.7$\times $ more causally load-bearing and 6$\times $ more sensitive to injected mistakes. The 7B model already knows the answer, its chains are decorative, and verbalising them costs accuracy. The 1.5B forced-answer rate is a caveat on the magnitude, not the direction (\secref {sec:discussion}). \relax }{table.caption.17}{}}
