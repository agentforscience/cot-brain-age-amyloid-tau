\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  {\em  (a)}\textsc  {CFIT}\xspace  shift for cited versus uncited features, alongside blinded rubric scores for genuine and shuffled rationales. {\em  (b)}Per-feature citation frequency against independently measured permutation importance. The chains saturate their citations---most features are named in most cases---so the ranking carries little signal on \textsc  {Tau-Stage}\xspace  . \relax }}{10}{figure.caption.11}\protected@file@percent }
\newlabel{fig:cfit_esa}{{4}{10}{\captiona \cfit shift for cited versus uncited features, alongside blinded rubric scores for genuine and shuffled rationales. \captionb Per-feature citation frequency against independently measured permutation importance. The chains saturate their citations---most features are named in most cases---so the ranking carries little signal on \taskone . \relax }{figure.caption.11}{}}
