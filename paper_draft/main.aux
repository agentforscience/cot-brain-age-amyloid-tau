\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  Performance under MCAR missingness and Gaussian feature noise, with every arm receiving the same corrupted values. The LLM curves are nearly horizontal, but they are horizontal at a level the tabular baselines only reach under extreme corruption. \textsc  {TabPFN\,v2}\xspace  dominates the LLM arm at every perturbation level on \textsc  {Brain-Age}\xspace  . \relax }}{11}{figure.caption.12}\protected@file@percent }
\newlabel{fig:robustness}{{5}{11}{Performance under MCAR missingness and Gaussian feature noise, with every arm receiving the same corrupted values. The LLM curves are nearly horizontal, but they are horizontal at a level the tabular baselines only reach under extreme corruption. \tabpfn dominates the LLM arm at every perturbation level on \tasktwo . \relax }{figure.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces  Degradation from clean data to 50\% MCAR missingness (AUC for \textsc  {Tau-Stage}\xspace  /\textsc  {Progression}\xspace  , MAE for \textsc  {Brain-Age}\xspace  ). The \textsc  {CoT}\xspace  arm is essentially flat under missingness on \textsc  {Tau-Stage}\xspace  and \textsc  {Brain-Age}\xspace  ---but flat at a level the baselines only fall \emph  {to} under extreme corruption. On \textsc  {Progression}\xspace  it is the least robust arm of all. The robustness claim is supported in slope and vacuous in level. \relax }}{11}{table.caption.13}\protected@file@percent }
\newlabel{tab:robustness}{{7}{11}{Degradation from clean data to 50\% MCAR missingness (AUC for \taskone /\taskthree , MAE for \tasktwo ). The \cotarm arm is essentially flat under missingness on \taskone and \tasktwo ---but flat at a level the baselines only fall \emph {to} under extreme corruption. On \taskthree it is the least robust arm of all. The robustness claim is supported in slope and vacuous in level. \relax }{table.caption.13}{}}
